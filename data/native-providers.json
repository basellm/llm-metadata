    "minimax-coding-plan": { "priority": 5 },
    "minimax-cn-coding-plan": { "priority": 4 },
    "stepfun-ai": { "priority": 20, "notes": "StepFun global endpoint." },
    "stepfun": { "priority": 10 },
    "stepfun-ai-step-plan": { "priority": 5 },
    "stepfun-step-plan": { "priority": 4 },
    "xiaomi": { "priority": 20 },
    "xiaomi-token-plan-ams": {},
    "xiaomi-token-plan-cn": {},
    "xiaomi-token-plan-sgp": {},
    "tencent-tokenhub": { "priority": 20 },
    "tencent-token-plan": { "priority": 10 },
    "tencent-coding-plan": {
      "excludeModels": ["^deepseek", "^glm", "^kimi", "^minimax"],
      "notes": "Keeps only Tencent's own Hunyuan models."
    },
    "longcat": {},
    "bailing": { "notes": "Ant Group Ling/Ring models." },
    "nova": { "notes": "Amazon's first-party Nova API (api.nova.amazon.com)." },
    "upstage": {},
    "sarvam": {},
    "sakana": {},
    "thinkingmachines": {},
    "poolside": {},
    "inception": {},
